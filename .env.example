# ============================================================
# ETS2 AI 副驾 - 配置模板
# 使用方法：复制本文件为 .env，然后填入你的 DeepSeek API Key
#   （Windows: copy .env.example .env）
# 只有 DEEPSEEK_API_KEY 是必填的，其余都有默认值，不写也能跑。
# ============================================================

# —— 必填：你的 DeepSeek API Key ——
DEEPSEEK_API_KEY=sk-在这里填你的key

# —— 可选：API 与模型（有默认值）——
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# —— 可选：副驾人设 ——
# 对应 personas/ 目录下的 .md 文件名（不含扩展名）
#   xiaoman = 小满（毒舌心软、卡车迷妹，默认）
#   gaoleng = 阿澈（高冷疏离、话少克制）
PERSONA=xiaoman

# —— 可选：语音识别（本地 Whisper）——
# 模型：base / small / medium / large，越大越准但越慢
WHISPER_MODEL=base
# 设备：cpu 或 cuda
#   cpu  = 用 CPU 识别（无需额外配置，稍慢，识别约 1 秒）
#   cuda = 用 GPU 识别（更快更准，识别约 0.3 秒）
#          ⚠️ 需要先运行 setup_gpu_stt.bat 安装 CUDA 依赖
#          ⚠️ RTX 50 系显卡必须用 cuda（自动用 float16，避免 INT8 报错）
WHISPER_DEVICE=cpu

# —— 可选：按住说话的热键 ——
# 支持：alt / ctrl / shift / space / enter / tab / esc / 单个字母(如 f)
PTT_KEY=alt

# —— 可选：语音（TTS）——
# 音色（默认陕西小妮，其他可选：zh-CN-XiaoxiaoNeural 等）
TTS_VOICE=zh-CN-shaanxi-XiaoniNeural
# 语速，如 +20% 或 -10%
TTS_RATE=+0%
# 音量 0.0~1.0（1.0=原声，0.5=一半音量）
TTS_VOLUME=1.0
