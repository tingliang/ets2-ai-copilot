# ============================================================
# ETS2 AI 副驾 - 配置模板
# 使用方法：复制本文件为 .env，然后填入你的 DeepSeek API Key
#   （Windows: copy .env.example .env）
# 只有 DEEPSEEK_API_KEY 是必填的，其余都有默认值，不写也能跑。
# ============================================================

# —— 必填：你的 DeepSeek API Key ——
DEEPSEEK_API_KEY=sk-在这里填你的key

# —— 可选：API 与模型（有默认值）——
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 单次回答的 token 上限（默认 256）。调大：聊游戏能讲更完整，但生成更慢、更耗 token；
# 调小：回复更短更快、更省 token。
LLM_MAX_TOKENS=256

# —— 可选：副驾人设 ——
# 对应 personas/ 目录下的 .md 文件名（不含扩展名）
#   xiaoman = 小满（毒舌心软、卡车迷妹，默认）
#   gaoleng = 阿澈（高冷疏离、话少克制）
PERSONA=xiaoman

# —— 可选：语音识别（本地 Whisper）——
# 模型：base / small / medium / large，越大越准但越慢
WHISPER_MODEL=base
# 设备：auto / cpu / cuda
#   auto = 自动探测（默认）：有 N 卡自动用 GPU，否则用 CPU，推荐
#   cpu  = 强制 CPU（无需额外配置，稍慢，识别约 1 秒）
#   cuda = 强制 GPU（更快更准，识别约 0.3 秒）
#          ⚠️ 需要先运行 setup_gpu_stt.bat 安装 CUDA 依赖
#          ⚠️ RTX 50 系显卡必须用 cuda（自动用 float16，避免 INT8 报错）
WHISPER_DEVICE=auto

# —— 可选：按住说话的热键 ——
# 支持：alt / ctrl / shift / space / enter / tab / esc / 单个字母(如 f)
PTT_KEY=alt

# —— 可选：语音输入模式（免按键 / 按键）——
# INPUT_MODE:
#   auto = 唤醒词免按键（默认）：持续监听，喊「WAKEWORD」后进入收音，
#          说完整句自动识别。适合开车时不想腾手按 Alt。
#   keys = 按住说话（传统 PTT）：按住 PTT_KEY 说话、松开发送。
INPUT_MODE=auto
# 唤醒词（仅 INPUT_MODE=auto 生效），喊这个词唤醒副驾开始听你说话
WAKEWORD=桃子

# —— 可选：语音合成（TTS 三引擎）——
# 引擎：
#   sherpa    = 本地离线中文女声（默认，推荐）：完全离线、国内零依赖、
#               断网也能用、零成本。首次运行会自动下载模型（约 190MB）。
#   cosyvoice = CosyVoice2 自然情感语音：自然度最高、支持情绪语气控制，
#               但需先运行 setup_cosyvoice.bat 装独立环境（约 4.5GB 模型）。
#               子进程起不来自动回退 sherpa。
#   edge      = 微软「陕西小妮」（需联网，境外接口，国内可能不稳定）
TTS_ENGINE=sherpa
# 下面两项仅 edge 引擎生效（sherpa/cosyvoice 引擎忽略）：
# 音色（默认陕西小妮，其他可选：zh-CN-XiaoxiaoNeural 等）
TTS_VOICE=zh-CN-shaanxi-XiaoniNeural
# 语速，如 +20% 或 -10%
TTS_RATE=+0%
# 语速（越大越快，1.0=默认，0.9 更慢，1.1 更快），sherpa 引擎生效
TTS_LOCAL_SPEED=1.0
# sherpa 引擎句首静音秒数（防第一个字被播放设备吞掉，默认 0.12）
TTS_LOCAL_LEAD_SILENCE=0.12
# 音量，1.0=原声，可 >1.0 放大（如 1.5），自动防削波
TTS_VOLUME=1.0
# 按句流式朗读：第一句合成完就开播、边播边合成后续句，
# 显著降低「听到声音」的等待（默认 true；false=整段合成后一次播放）
# 仅 sherpa 引擎生效
TTS_STREAM=true
# —— CosyVoice2（第三引擎，可选）——
# 子进程 HTTP 服务地址（一般不用改）
COSYVOICE_HOST=127.0.0.1
COSYVOICE_PORT=9860
# 是否启用情绪控制（把 happy/angry/sad 等映射成 CosyVoice 的语气指令）
COSYVOICE_EMOTION=true
# CosyVoice 语速（独立于上面的 TTS_LOCAL_SPEED）。流式下官方 speed 无效，
# 这里做后处理变速。默认 1.0（参考音频本身语速已较快）。1.0=原速，1.3 明显快。
COSYVOICE_SPEED=1.0
# 零样本音色克隆：换一段参考音频即可换音色（不用重新训练）。
# COSYVOICE_PROMPT_WAV  = 参考音频路径（3~10 秒、清晰、单说话人）
# COSYVOICE_PROMPT_TEXT = 参考音频里**逐字对应**的文本（中文参考音频必须完全一致，否则会乱念）
# 默认值：voices/kid_voice.wav（用户儿子童声）+ 对应文字，即「不写这两行 = 童声」。
#   想恢复官方成人女声：把这两行显式清空并指向官方音频（见 config.py 注释）。
# 换成别的音色（中文参考音频）示例：
#   COSYVOICE_PROMPT_WAV=C:/Users/kensa/Documents/ets2-ai-copilot/voices/xxx.wav
#   COSYVOICE_PROMPT_TEXT=参考音频里说的话
# 参考音频若不是中文（英文/日文等），把 COSYVOICE_PROMPT_TEXT 留空即可，
# 程序会自动切到跨语言克隆（只借音色、不借内容）：
#   COSYVOICE_PROMPT_WAV=C:/Users/kensa/Documents/ets2-ai-copilot/voices/xxx_en.wav
#   COSYVOICE_PROMPT_TEXT=
COSYVOICE_PROMPT_WAV=
COSYVOICE_PROMPT_TEXT=

